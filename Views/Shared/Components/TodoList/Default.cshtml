@model IEnumerable<TodoApp.Models.TodoItem>

@if (!Model.Any())
{
    <div class="alert alert-info">Нет задач для отображения.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Название</th>
                <th>Статус</th>
                <th>
                    <a asp-action="Index" 
                       asp-route-sortOrder="@(Context.Request.Query["sortOrder"] == "asc" ? "desc" : "asc")"
                       asp-route-statusFilter="@Context.Request.Query["statusFilter"]"
                       asp-route-searchQuery="@Context.Request.Query["searchQuery"]">
                        Дата создания
                    </a>
                </th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                @await Component.InvokeAsync("TodoItem", new { item = item })
            }
        </tbody>
    </table>
}