@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1 class="text-danger">Ошибка.</h1>
<h2 class="text-danger">Произошла ошибка во время обработки вашего запроса.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Идентификатор запроса (Request ID):</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Режим разработки</h3>
<p>
    Переключение в среду <strong>Разработки (Development)</strong> отобразит более подробную информацию о возникшей ошибке.
</p>
<p>
    <strong>Среду разработки не следует включать в развернутых приложениях.</strong>
    Это может привести к раскрытию конфиденциальной информации из исключений для конечных пользователей.
    Для локальной отладки включите среду разработки, установив переменную среды <strong>ASPNETCORE_ENVIRONMENT</strong> в значение <strong>Development</strong> и перезапустив приложение.
</p>
