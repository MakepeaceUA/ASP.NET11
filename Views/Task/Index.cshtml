@{
    ViewData["Title"] = "Планировщик задач";
    var statusFilter = ViewData["StatusFilter"]?.ToString() ?? "";
    var sortOrder = ViewData["SortOrder"]?.ToString() ?? "asc";
    var searchQuery = ViewData["SearchQuery"]?.ToString() ?? "";
}

<style>
    .completed-task {
        text-decoration: line-through;
        color: #888;
    }
</style>

<h1>@ViewData["Title"]</h1>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Create" class="btn btn-primary">Создать новую задачу</a>
        <a asp-action="DownloadTasks" class="btn btn-secondary">Скачать список</a>
    </div>
    <div>
        <form asp-action="Index" method="get" class="d-inline-flex">
            <input type="text" name="searchQuery" value="@searchQuery" class="form-control" placeholder="Поиск..." />
            <button type="submit" class="btn btn-info ms-2">Искать</button>
        </form>
    </div>
</div>

<div class="mb-3">
    <strong>Фильтры:</strong>
    <a asp-action="Index" asp-route-statusFilter="" asp-route-sortOrder="@sortOrder" asp-route-searchQuery="@searchQuery" class="btn btn-sm @(string.IsNullOrEmpty(statusFilter) ? "btn-primary" : "btn-outline-primary")">Все</a>
    <a asp-action="Index" asp-route-statusFilter="pending" asp-route-sortOrder="@sortOrder" asp-route-searchQuery="@searchQuery" class="btn btn-sm @(statusFilter == "pending" ? "btn-warning" : "btn-outline-warning")">Невыполненные</a>
    <a asp-action="Index" asp-route-statusFilter="completed" asp-route-sortOrder="@sortOrder" asp-route-searchQuery="@searchQuery" class="btn btn-sm @(statusFilter == "completed" ? "btn-success" : "btn-outline-success")">Выполненные</a>
</div>

@await Component.InvokeAsync("TodoList", new { statusFilter = statusFilter, sortOrder = sortOrder, searchQuery = searchQuery })