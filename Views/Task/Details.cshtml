@model TodoApp.Models.TodoItem
@{
    ViewData["Title"] = "Детали задачи";
}
<h1>@ViewData["Title"]</h1>
<div>
    <h4>Задача: @Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Описание</dt>
        <dd class="col-sm-10">@(Model.Description ?? "Нет описания")</dd>

        <dt class="col-sm-2">Статус</dt>
        <dd class="col-sm-10">@(Model.IsCompleted ? "Выполнено" : "В процессе")</dd>

        <dt class="col-sm-2">Создано</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("F")</dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-primary">Назад к списку</a>
</div>
